FROM registry.fedoraproject.org/fedora:44
RUN dnf --repo=fedora --repo=updates -y install \
        ShellCheck \
        python3 \
        python3-copr \
        rpmlint \
        ruff \
    && dnf clean all
RUN shellcheck --version && rpmlint --version
ENV RUFF_CACHE_DIR=/tmp/ruff \
    PYTHONPYCACHEPREFIX=/tmp/pycache
WORKDIR /workspace
CMD ["python3", "ci/check.py"]
